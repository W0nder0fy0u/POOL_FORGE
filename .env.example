# PoolForge Environment Variables Example

# Coordinator configuration
POOLFORGE_HOST=0.0.0.0
POOLFORGE_PORT=8000
POOLFORGE_SECRET_KEY=change-this-in-production-random-secret
POOLFORGE_DB_PATH=poolforge.db

# Agent default configuration
POOLFORGE_SERVER_URL=http://localhost:8000
POOLFORGE_HEARTBEAT_INTERVAL=2.0
POOLFORGE_TRANSPORT=relay

# Benchmarks / Simulation
POOLFORGE_SIMULATE_LATENCY_MS=0
