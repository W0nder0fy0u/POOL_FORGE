# PoolForge environment variables (all optional; defaults shown).
# Copy to .env and edit, or set them in your hosting provider's dashboard.

# --- Coordinator ---
POOLFORGE_HOST=0.0.0.0
# Render/Railway inject PORT; POOLFORGE_PORT is used if PORT is not set.
POOLFORGE_PORT=8000
POOLFORGE_DB_PATH=data/poolforge.db
# Rate limits per IP per minute
POOLFORGE_ROOMS_PER_MIN=10
POOLFORGE_JOINS_PER_MIN=20
# Seconds a dropped node may be away before its job is failed.
POOLFORGE_DROP_GRACE_S=30
# Public URL shown in join commands (auto-detected from the request if empty).
POOLFORGE_PUBLIC_URL=
# Git URL of this project, shown on the Join page (e.g. https://github.com/you/poolforge)
POOLFORGE_REPO_URL=

# --- Agent (CLI flags override these) ---
POOLFORGE_SERVER=http://localhost:8000
POOLFORGE_TRANSPORT=relay
